<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="SoccerHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:Label name="score-label" text="BLUE  0  :  0  PURPLE" class="hud-box score-box" />
        <ui:Label name="time-label" text="03:00" class="hud-box time-box" />
        <ui:VisualElement class="hud-box mode-box">
            <ui:VisualElement class="mode-row">
                <ui:Label name="ai-label" text="AI  OFF" class="mode-pill mode-off" />
                <ui:Label name="human-label" text="HUMAN  ON" class="mode-pill mode-on" />
            </ui:VisualElement>
            <ui:Label name="hint-label" text="H / Xbox Y  CONTROL MODE" class="hint-label" />
        </ui:VisualElement>
        <ui:Label name="result-label" text="" class="result-label" />
        <ui:VisualElement class="controls-box">
            <ui:Label text="W / RT  FORWARD" />
            <ui:Label text="S / LT  REVERSE" />
            <ui:Label text="A D / LEFT STICK  TURN" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
