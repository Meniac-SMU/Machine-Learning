.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(240, 245, 250);
    font-size: 20px;
}

.hud-box {
    position: absolute;
    padding: 11px 16px;
    background-color: rgba(12, 18, 27, 0.88);
    border-width: 1px;
    border-color: rgba(132, 154, 178, 0.42);
    border-radius: 9px;
}

.score-box {
    left: 20px;
    top: 20px;
    color: rgb(233, 240, 248);
    font-size: 22px;
    -unity-font-style: bold;
}

.time-box {
    left: 50%;
    top: 20px;
    translate: -50% 0;
    min-width: 108px;
    color: rgb(255, 226, 135);
    font-size: 27px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.mode-box {
    right: 20px;
    top: 20px;
}

.mode-row {
    flex-direction: row;
    justify-content: flex-end;
}

.mode-pill {
    min-width: 94px;
    margin-left: 7px;
    padding: 5px 9px;
    border-radius: 5px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.mode-on {
    color: rgb(178, 255, 207);
    background-color: rgba(27, 126, 74, 0.72);
}

.mode-off {
    color: rgb(174, 184, 196);
    background-color: rgba(66, 74, 84, 0.74);
}

.hint-label {
    margin-top: 7px;
    color: rgb(151, 185, 218);
    font-size: 13px;
    -unity-text-align: middle-right;
}

.controls-box {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 10px 14px;
    color: rgb(180, 197, 214);
    background-color: rgba(12, 18, 27, 0.76);
    border-radius: 8px;
    font-size: 13px;
}

.result-label {
    position: absolute;
    left: 50%;
    top: 42%;
    translate: -50% -50%;
    min-width: 330px;
    padding: 20px 34px;
    color: rgb(255, 241, 184);
    background-color: rgba(8, 12, 18, 0.92);
    border-width: 2px;
    border-color: rgba(255, 221, 114, 0.65);
    border-radius: 11px;
    font-size: 34px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    display: none;
}
