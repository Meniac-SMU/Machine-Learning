.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(240, 245, 250);
    font-size: 20px;
}

.hud-box {
    position: absolute;
    padding: 11px 16px;
    background-color: rgba(12, 18, 27, 0.88);
    border-width: 1px;
    border-color: rgba(132, 154, 178, 0.42);
    border-radius: 9px;
}

.score-box {
    left: 20px;
    top: 20px;
    color: rgb(233, 240, 248);
    font-size: 22px;
    -unity-font-style: bold;
}

.time-box {
    left: 50%;
    top: 20px;
    translate: -50% 0;
    min-width: 108px;
    color: rgb(255, 226, 135);
    font-size: 27px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.mode-box {
    right: 20px;
    top: 20px;
}

.mode-row {
    flex-direction: row;
    justify-content: flex-end;
}

.mode-pill {
    min-width: 94px;
    margin-left: 7px;
    padding: 5px 9px;
    border-radius: 5px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.mode-on {
    color: rgb(178, 255, 207);
    background-color: rgba(27, 126, 74, 0.72);
}

.mode-off {
    color: rgb(174, 184, 196);
    background-color: rgba(66, 74, 84, 0.74);
}

.tactic-reward-box {
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    min-width: 330px;
}

.panel-title {
    margin-bottom: 7px;
    color: rgb(255, 226, 135);
    font-size: 14px;
    -unity-font-style: bold;
}

.blue-value {
    margin-bottom: 5px;
    color: rgb(111, 201, 255);
    font-size: 15px;
}

.purple-value {
    color: rgb(201, 162, 255);
    font-size: 15px;
}

.reward-value {
    font-size: 18px;
    -unity-font-style: bold;
}

.panel-divider {
    height: 1px;
    margin-top: 11px;
    margin-bottom: 11px;
    background-color: rgba(132, 154, 178, 0.42);
}

.controls-box {
    position: absolute;
    left: 20px;
    bottom: 20px;
    min-width: 314px;
    padding: 11px 13px;
    color: rgb(180, 197, 214);
    background-color: rgba(12, 18, 27, 0.76);
    border-width: 0;
    border-radius: 8px;
    font-size: 13px;
}

.controls-row {
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.controls-header-row {
    margin-bottom: 3px;
    color: rgb(230, 237, 245);
    -unity-font-style: bold;
}

.controls-cell {
    padding-left: 4px;
    padding-right: 4px;
    -unity-text-align: middle-center;
}

.controls-action-cell {
    width: 72px;
}

.controls-key-cell {
    width: 82px;
}

.controls-pad-cell {
    width: 116px;
}

.result-label {
    position: absolute;
    left: 50%;
    top: 42%;
    translate: -50% -50%;
    min-width: 330px;
    padding: 20px 34px;
    color: rgb(255, 241, 184);
    background-color: rgba(8, 12, 18, 0.92);
    border-width: 2px;
    border-color: rgba(255, 221, 114, 0.65);
    border-radius: 11px;
    font-size: 34px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    display: none;
}
