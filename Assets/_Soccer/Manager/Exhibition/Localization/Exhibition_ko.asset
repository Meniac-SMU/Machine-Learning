  - m_Id: 825827410
    m_Localized: "\uD68C\uC218 \uC6B0\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 825827411
    m_Localized: "Recover: \uD68C\uC218 \uC6B0\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 825827412
    m_Localized: "\uACF5\uC744 \uB418\uCC3E\uB294 \uC120\uD0DD\uC744 \uC6B0\uC120\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 825827413
    m_Localized: "\uADE0\uD615 \uC720\uC9C0"
