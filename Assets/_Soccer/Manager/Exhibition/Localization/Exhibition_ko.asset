      m_Items: []
  - m_Id: 825827392
    m_Localized: "\uD6C4\uBC29 \uBCF4\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 825827393
    m_Localized: "\uC81C\uC791\uC790 \uC18C\uAC1C \uC784\uC2DC \uC774\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 825827394
    m_Localized: "\uACBD\uAE30\uC7A5 \uAD6C\uB3C4 \uC608\uC2DC \uC774\uBBF8\uC9C0.
      \uC2E4\uC81C \uAC8C\uC784 \uB80C\uB354\uB9C1\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 825827395
    m_Localized: "\uC9C1\uC811 \uD50C\uB808\uC774\uC5D0\uC11C\uB294 RED \uACF5\uACA9\uC218\uB97C
      \uC870\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 825827396
    m_Localized: "W/S \uC774\uB3D9, A/D \uD68C\uC804, E \uD328\uC2A4, Space \uC288\uD305,
      H AI \uC804\uD658."
    m_Metadata:
      m_Items: []
  - m_Id: 825827397
    m_Localized: "\uC591 \uD300 \uBAA8\uB378\uACFC 5\uBD84 \uB610\uB294 10\uBD84\uC744
      \uC120\uD0DD\uD558\uBA70, \uACBD\uAE30 \uD6C4 \uC885\uB8CC \uBC84\uD2BC\uC73C\uB85C
      \uC2DC\uC791 \uD654\uBA74\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
