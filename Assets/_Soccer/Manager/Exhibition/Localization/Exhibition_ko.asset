      m_Items: []
  - m_Id: 825827419
    m_Localized: "\uBB34\uC791\uC704 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 825827420
    m_Localized: "Random: \uBB34\uC791\uC704 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 825827421
    m_Localized: "\uBD88\uAC00\uB2A5\uD55C \uD589\uB3D9\uC744 \uC81C\uC678\uD558\uACE0
      \uBB34\uC791\uC704\uB85C \uC120\uD0DD\uD569\uB2C8\uB2E4."
