      m_Items: []
  - m_Id: 825827380
    m_Localized: "\uBAA8\uB378 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 825827381
    m_Localized: "\uBAA8\uB4E0 \uAC15\uD654\uD559\uC2B5 \uBAA8\uB378\uC740 100\uB9CC
      \uD68C\uC758 \uC0AC\uC804 \uD559\uC2B5\uC744 \uAC70\uCCE4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 825827382
    m_Localized: "\uAC01 \uAC10\uB3C5\uC740 \uAC19\uC740 \uC120\uC218 \uAE30\uC220\uC744
      \uC0AC\uC6A9\uD558\uBA70, \uC11C\uB85C \uB2E4\uB978 \uADDC\uCE59\uC73C\uB85C
      \uC804\uB7B5\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 825827383
    m_Localized: "\uAC10\uB3C5 \uD604\uD669"
    m_Metadata:
      m_Items: []
